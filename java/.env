# Dataset options ====================================================

# DATA_TOPIC=[iris-input|wine-input]

# DATASET=iris
# DATA_TOPIC=iris-input  

# DATASET=wine
# DATA_TOPIC=wine-input     

# DATASET=mnist
# DATA_TOPIC=mnist-input  

# DATASET=susy
# DATA_TOPIC=susy-input  

# DATASET=iris
# DATASET=wine
# DATASET=mnist
# DATASET=susy
DATASET=bank

NUM_FEATURES_IRIS=4
NUM_CLASSES_IRIS=3
NUM_FEATURES_WINE=13
NUM_CLASSES_WINE=3
NUM_FEATURES_MNIST=784          # 28 * 28 = 784
NUM_CLASSES_MNIST=10
NUM_FEATURES_SUSY=18         
NUM_CLASSES_SUSY=2
NUM_FEATURES_BANK=53   
NUM_CLASSES_BANK=2

# Topics ===============================================================

PBEST_WEIGHTS_TOPIC=pbest-weights-topic
LOCAL_WEIGHTS_TOPIC=local-weights-topic
GLOBAL_WEIGHTS_TOPIC=global-weights-topic
PREDICTION_INPUT_TOPIC=prediction_input
PREDICTION_OUTPUT_TOPIC=prediction_output

# PSO options ===============================================================

NUM_WORKERS=5      # In the literature of PSO, it is common to set the population size to a size between 20 to 50 particles

BATCH_SIZE=150       
N_BATCHES=10     

DESIRED_ACCURACY=0.9
W_INERTIA=0.95
W_INERTIA_G_BEST=0.7

C=1.7     
C1=1.0     
C2=2.0     

FULLY_INFORMED=false

LOSS_FUNCTION=L2     # LOSS_FUNCTION=[L2|CROSS_ENTROPY|TOP_K]
TOP_K_VALUE=2

VEL_MAX_FACTOR=0.1

SIGNIFICANT_LOSS=0.4

# Misc =======================================================================

SAVE_MODEL_NAME=global-model

ENABLE_LOGGING=0

NUMBER_OF_DATA_REPEATS=500
NUMBER_OF_DATA_REPEATS_TEST=200

DEBUG_KAFKA=false




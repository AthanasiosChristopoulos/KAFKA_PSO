KAFKA_TMP_DIR=/mnt/nas_drive/achristopoulos/kstreams-state
KAFKA_HOST=localhost:19092

# Names of Topics ======================================================

# DATA_TOPIC=susy-input
# TEST_TOPIC=susy-test
PBEST_WEIGHTS_TOPIC=pbest-weights-topic
LOCAL_WEIGHTS_TOPIC=local-weights-topic
GPEST_WEIGHTS_TOPIC=global-weights-topic
PREDICTION_INPUT_TOPIC=prediction-input
PREDICTION_OUTPUT_TOPIC=prediction-output

# Dataset options ====================================================

NUM_FEATURES_IRIS=4
NUM_CLASSES_IRIS=3
NUM_FEATURES_WINE=13
NUM_CLASSES_WINE=3
NUM_FEATURES_MNIST=784          # 28 * 28 =784
NUM_CLASSES_MNIST=10
NUM_FEATURES_MNIST4=784          # 28 * 28 = 784
NUM_CLASSES_MNIST4=4
NUM_FEATURES_FASHION_MNIST=784          # 28 * 28 = 784
NUM_CLASSES_FASHION_MNIST=10
NUM_FEATURES_SUSY=18         
NUM_CLASSES_SUSY=2
NUM_SAMPLES_SUSY=808000
NUM_FEATURES_BANK=53   
NUM_CLASSES_BANK=2
NUM_FEATURES_ADULT_INCOME=96
NUM_CLASSES_ADULT_INCOME=1
NUM_FEATURES_COVERTYPE=54
NUM_CLASSES_COVERTYPE=7
NUM_FEATURES_HAR=561
NUM_CLASSES_HAR=6
NUM_FEATURES_PENDIGITS=16
NUM_CLASSES_PENDIGITS=10
NUM_SAMPLES_PENDIGITS=1538200
NUM_FEATURES_PENDIGITS_HALF=16
NUM_CLASSES_PENDIGITS_HALF=5
NUM_SAMPLES_PENDIGITS_HALF=418000
NUM_FEATURES_WINEQUALITY=12
NUM_CLASSES_WINEQUALITY=2
NUM_FEATURES_LETTER=16
NUM_CLASSES_LETTER=26
NUM_FEATURES_CIFAR3=3072    # 32 * 32 * 3 = 3072
NUM_CLASSES_CIFAR3=3
NUM_FEATURES_CIFAR10=3072    # 32 * 32 * 3 = 3072
NUM_CLASSES_CIFAR10=10
NUM_FEATURES_CIFAR5=3072    # 32 * 32 * 3 = 3072
NUM_CLASSES_CIFAR5=5

# ========================================================
# DATASET=iris
# DATASET=wine    
# DATASET=susy
# DATASET=bank        # highly imbalanced dataset almost always class_0, no class_1
# DATASET=adult
# DATASET=covertype
# DATASET=har
# DATASET=higgs
# DATASET=winequality
# DATASET=letter
# DATASET=fashion_mnist
# =========================================================
# DATASET=pendigits
# DATASET=pendigits-half
# DATASET=mnist
# DATASET=mnist4  
# DATASET=cifar10
# DATASET=cifar3
DATASET=cifar5

# PSO options ===============================================================

# 20 - 50 Workers / Particles, 2 Page 10034

# BATCH_SIZE=100 
BATCH_SIZE=100
# BATCH_SIZE=10
TEST_SIZE=-1
TEST_BATCH_SIZE=100

BATCH_FLUSH=1000        # For Kafka Data Producer

# Closing Criteria =========================================================================================

DESIRED_ACCURACY=1.0    # Basically means stop training when the data ends
STOP_ON_CONVERGENCE=true
# STOP_ON_CONVERGENCE=false
CONVERGENCE_STRICTNESS_FACTOR=0.5

# =================================================================================================

LOSS_FUNCTION=CROSS_ENTROPY     # [L2 | CROSS_ENTROPY] (differentiable)
# LOSS_FUNCTION=MAE                   # [MAE|ZERO_ONE] (non - differentiable)
# COMBINE_LOSS=SUM                # COMBINE_LOSS=[AVG | TOP_K | SUM]
COMBINE_LOSS=AVG
# COMBINE_LOSS=TOP_K
TOP_K_VALUE=40      
REGULARIZER=NONE                  # [L2|SLOPE|GROUP_LASSO]

# Experimentation Variables =======================================================================

FULLY_INFORMED=true
       
# INERTIA_FULLY=0.95
INERTIA_FULLY=0.9
C=3.0

# =================================================================================================
# FULLY_INFORMED=false      # Neighborhood Best
# INERTIA_G_BEST=0.9
# C1=2.0     
# C2=2.0 

# With Constriction Factor:
# INERTIA_G_BEST=0.729
# C1=1.494      
# C2=1.494  

# Performance =========================================================================================

# ND4J_PROFILE=cpu        # [cpu|gpu]
ND4J_PROFILE=gpu            # Drastically improves forward pass performance, but also causes overhead 
# for communication between cpu and gpu. If forwardPassNs not significant enough then choose cpu instead

# MEMORY_EFFICIENT=true       # costs around 55 ms Prediction cost (mostly the .putScalar method)
MEMORY_EFFICIENT=false    # costs around 22 ms Predicition cost (mostly the forward pass, meaning the competion of the workers over the GPU) 

# Topology =============================================================================================
N_WORKERS=15      # In the literature of PSO, it is common to set the population size to a size between 20 to 50 particles

# ENABLE_NEIGHBORHOODS=false
ENABLE_NEIGHBORHOODS=true
NEIGHBORHOOD_SIZE=6
INCLUDE_SELF=true                  # If false then URing, else Ring Topology
# NEIGHBORHOOD_TOPOLOGY=ring    # [square|ring]
NEIGHBORHOOD_TOPOLOGY=square

INDEPENDENT_WORKER_DATA_PROCESSING=true         # [true|false]
INERTIA_START=1.9 
INERTIA_END=0.8
# INDEPENDENT_WORKER_DATA_PROCESSING=true         # [true|false]
# INERTIA_START=1.6 
# INERTIA_END=0.6
# INERTIA_START=1.4    
# INERTIA_END=0.6    
# INDEPENDENT_WORKER_DATA_PROCESSING=false  # in this case inertia and other parameters that lead to high exploration need to be significantly reduced 
# INERTIA_START=1.4    
# INERTIA_END=0.6  

# ===============================================================================================
# Exploiation vs Exploration ====================================================================

# 1) 
ADAPTIVE_INERTIA=true   # [false|true]
# ADAPTIVE_INERTIA=false
# INERTIA_START=1.7     # Inertia needs to be increased with caution. Swarm convergence behavior greatly
# INERTIA_END=0.7       # dpeends from it as well as average processing time

# 2) 
ACCELARATION_COEFF_TIME_VARYING=true
# ACCELARATION_COEFF_TIME_VARYING=false
C1_START=2.5
C1_END=0.5
C2_START=0.5 
C2_END=2.5
C_START=2.0 
C_END=4.0

# 3) 
VMAX_FACTOR=0.2                 # Increasing this helps exploration but going overboard makes convergence impossible 
# VMAX_FACTOR=0.4               # VMAX_FACTOR = δ, from the paper Vmax = δ(xmax − xmin), with δ = (0, 1], xmax and xmin are the maximum and minimum values of the search space boundary respectively
VMAX_CLAMPING_TYPE=DIM          # [DIM|NORM], DIM isnt problematic, we dont mind randmoness either way
# VMAX_CLAMPING_TYPE=NORM    

# 4) Imrpoves exploration but only for fully informed
GIVE_HALF_TO_SELF=false
# GIVE_HALF_TO_SELF=true

FREEZE=true     # Freeze pretrained Model weights, FREEZE == true, means FREEZE
FREEZE_INDEX=2

# =================================================================================================

WEIGHTS_ON_UPDATEX=false    # Weight (usually fitness) scaling in the velocity update

# Filtering: =======================================================================

# FILTER_ENABLED=true
FILTER_ENABLED=false

# SIGNIFICANT_LOSS_DIFF=200000      # Completely shut down communication
# SIGNIFICANT_LOSS_DIFF=1.0
# SIGNIFICANT_LOSS_DIFF=0.05      # This means dont send, if it hasnt improved at least 5% from the last time
SIGNIFICANT_LOSS_DIFF=0.0           # Only filter the Federated Learning Weight Monitoring

LOSS_THRESHOLD_MAX=0.1
LOSS_THRESHOLD_MIN=0.01

PBEST_DEBOUNCE_MS=100

N_BATCHES=10  
MONITORING_THRESHOLD_MAX=60
MONITORING_THRESHOLD_MIN=15

# Misc =======================================================================

SAVE_MODEL_NAME=global-model

ENABLE_LOGGING=true
# ENABLE_LOGGING=false
LOGGER_LEVEL=0

DEBUG_KAFKA=false
# DEBUG_KAFKA=true

LOG_TASK_INSTANCES=true

SAMPLING_CONSTANT=3

MONITORING_THRESHOLD=40
POINTS_PER_AXIS=5

IDLE_MS=3000

CONVERGENCE_ALPHA=0.15 
# CONVERGENCE_ALPHA=0.1
# CONVERGENCE_RADIUS=0.01

WEIGHTS_INIT_SCALE=1
WEIGHT_CLAMPING=true
WEIGHT_MAX_SCALE=10     # Just to be safe, its so that weight doesnt explode

EXPERIMENTATION_MODE=THRESHOLD     # [THRESHOLD|N_WORKERS]
# EXPERIMENTATION_MODE=N_WORKERS


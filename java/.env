# ========================================================
# Experimentation checklist
# 1) Data:

HEAVY_SAMPLES=false
# HEAVY_SAMPLES=true

# DATASET=iris
# DATASET=wine
# DATASET=susy
# DATASET=winequality
DATASET=pendigits
# DATASET=pendigits-half

# =========================================================
# DATASET=mnist
# DATASET=mnist5
# DATASET=fashion-mnist
# DATASET=fashion-mnist-half
# DATASET=fashion-mnist5-half

# DATASET=kmnist
# DATASET=cifar10
# DATASET=cifar3
# DATASET=cifar5
# DATASET=cifar10-half
# DATASET=cifar5-half
# DATASET=nsfw
# DATASET=svhn

# ================================
# General / System Settings
# ================================

ND4J_PROFILE=cpu                   
# [cpu|gpu]
# gpu: Drastically improves forward pass performance, but has overhead

BATCH_SIZE=100
# BATCH_SIZE=10
TEST_BATCH_SIZE=300
# TEST_BATCH_SIZE=500
N_BATCHES=10
BATCH_FLUSH=1000              

MEMORY_EFFICIENT=false          

EXPERIMENTATION_MODE=MONITORING_ITERATIONS     
# [N_WORKERS|FILTER_ENABLED|THRESHOLD|MONITORING_ITERATIONS]
# [FILTER_STRENGTH|FULLY_INFORMED_VS_CLASSICAL|DIMENSIONALITY|TOPOLOGY|LOSS_FUNCTIONS]

PREDICTION_MODELS=false            

# ================================
# PSO Core Parameters
# ================================
N_WORKERS=12
# In the literature of PSO, it is common to set the population size to a size between 20 to 50 particles

DATASET_PARTITIONING=false       

FULLY_INFORMED=true
INERTIA_FULLY=0.9
C=3.0

# ================================
# PSO Techniques
# ================================
ADAPTIVE_INERTIA=true       

# for DATASET_PARTITIONING = false
INERTIA_START=1.9      
INERTIA_END=0.8

# for DATASET_PARTITIONING = true
# INERTIA_START=1.4   
# INERTIA_END=0.6

ACCELARATION_COEFF_TIME_VARYING=true
C1_START=2.5
C1_END=0.5
C2_START=0.5
C2_END=2.5
C_START=2.0
C_END=4.0

VMAX_FACTOR=0.2                    
# Increasing this helps exploration but going overboard makes convergence impossible

VMAX_CLAMPING_TYPE=DIM             
# [DIM|NORM], DIM isnt problematic, we dont mind randmoness either way

WEIGHTS_ON_UPDATEX=false           
# Weight (usually fitness) scaling in the velocity update

# ================================
# Neighborhood Configuration
# ================================
ENABLE_NEIGHBORHOODS=true
NEIGHBORHOOD_SIZE=4
INCLUDE_SELF=true                  
# If false then URing, else Ring Topology
NEIGHBORHOOD_TOPOLOGY=ring         
# [square|ring]

GIVE_HALF_TO_SELF=false

# ================================
# Termination / Early Stopping
# ================================
IDLE_MS=6000

DESIRED_ACCURACY=1.0  

EARLY_STOPPING=false

CONVERGENCE_STRICTNESS_FACTOR=0.5
CONVERGENCE_ALPHA=0.15
MAX_NO_IMPROVEMENT_ROUNDS=70

# ================================
# Loss Function Configuration
# ================================
# Differentiable ====================================================================

LOSS_FUNCTION=CROSS_ENTROPY        
# [L2 | CROSS_ENTROPY] (differentiable)

# Non - Differentiable ====================================================================
# LOSS_FUNCTION=HINGE              
# [MAE|ZERO_ONE|ABSOLUTE_MARGIN|HINGE|RAMP]

            
COMBINE_LOSS=AVG       
# COMBINE_LOSS=[AVG | TOP_K | SUM]
TOP_K_VALUE=70
REGULARIZER=NONE                   
# [L2|SLOPE|GROUP_LASSO]

# ================================
# Communication / Filtering
# ================================
FILTER_ENABLED=false

LOSS_THRESHOLD_MAX=0.1
LOSS_THRESHOLD_MIN=0.01

PBEST_DEBOUNCE_MS=75

MONITORING_THRESHOLD_MAX=60
MONITORING_THRESHOLD_MIN=15

MONITORING_THRESHOLD=50

# ================================
# Logging / Debugging
# ================================
ENABLE_LOGGING=true
LOGGER_LEVEL=0
DEBUG_KAFKA=false
LOG_TASK_INSTANCES=true

# ================================
# Miscellaneous
# ================================
SAMPLING_CONSTANT=3
POINTS_PER_AXIS=5

WEIGHTS_INIT_SCALE=1
WEIGHT_CLAMPING=true
WEIGHT_MAX_SCALE=10                
# Just to be safe, its so that weight doesnt explode

# SAVE_MODEL_NAME=global-model     
# set it so that the final model will be saved. Otherwise it wont

EXPERIMENTATION_DIR=experimental_results_server
EVALUATE_PRETRAINED=false
MODEL_VERSION=-1

FREEZE=true     
FREEZE_INDEX=0

FEDERATED_SETTING=false
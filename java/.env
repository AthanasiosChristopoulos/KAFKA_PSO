# Dataset options ====================================================

# DATASET=iris
# DATASET=wine
# DATASET=mnist
# DATASET=susy
# DATASET=bank        # highly imbalanced dataset almost always class_0, no class_1
# DATASET=adult
# DATASET=covertype
# DATASET=har
# DATASET=pendigits
# DATASET=cifar10
# DATASET=higgs
DATASET=winequality

NUM_FEATURES_IRIS=4
NUM_CLASSES_IRIS=3
NUM_FEATURES_WINE=13
NUM_CLASSES_WINE=3
NUM_FEATURES_MNIST=784          # 28 * 28 = 784
NUM_CLASSES_MNIST=10
NUM_FEATURES_SUSY=18         
NUM_CLASSES_SUSY=2
NUM_FEATURES_BANK=53   
NUM_CLASSES_BANK=2
NUM_FEATURES_ADULT_INCOME=96
NUM_CLASSES_ADULT_INCOME=1
NUM_FEATURES_COVERTYPE=54
NUM_CLASSES_COVERTYPE=7
NUM_FEATURES_HAR=561
NUM_CLASSES_HAR=6
NUM_FEATURES_PENDIGITS=16
NUM_CLASSES_PENDIGITS=10
NUM_FEATURES_WINEQUALITY=12
NUM_CLASSES_WINEQUALITY=2

# Topics ===============================================================

# DATA_TOPIC=susy-input
# TEST_TOPIC=susy-test
PBEST_WEIGHTS_TOPIC=pbest-weights-topic
LOCAL_WEIGHTS_TOPIC=local-weights-topic
GLOBAL_WEIGHTS_TOPIC=global-weights-topic
PREDICTION_INPUT_TOPIC=prediction-input
PREDICTION_OUTPUT_TOPIC=prediction-output

# PSO options ===============================================================

N_WORKERS=5      # In the literature of PSO, it is common to set the population size to a size between 20 to 50 particles

# 20 - 50 Workers / Particles, 2 Page 10034

TRAIN_SIZE=75
# TRAIN_SIZE=150  
# TEST_SIZE=200
# TEST_SIZE=250     
# TEST_SIZE=1000  
TEST_SIZE=-1

TRAIN_TEST_SPLIT=0.8     
N_BATCHES=10     
BATCH_FLUSH=1000        # For Kafka Data Producer

DESIRED_ACCURACY=1.0    # Basically means stop training when the data ends
W_INERTIA_FULLY=0.9
W_INERTIA_G_BEST=0.7

# w = [0.8, 1.2], 2 page 10035

C=2.5     
C1=2.0     
C2=2.0     

# C1 = C2 = 2 or C1 = C2 = 1.49 , 2 page 10035

# FULLY_INFORMED=true
FULLY_INFORMED=false

LOSS_FUNCTION=CROSS_ENTROPY     # LOSS_FUNCTION=[L2 | CROSS_ENTROPY]
LOSS_COMBINE=SUM                # LOSS_COMBINE=[AVG | TOP_K | SUM]
TOP_K_VALUE=40

VMAX_FACTOR=0.1

SIGNIFICANT_LOSS_DIFF=0.5

# Misc =======================================================================

SAVE_MODEL_NAME=global-model

ENABLE_LOGGING=0

NUMBER_OF_DATA_REPEATS=500
NUMBER_OF_DATA_REPEATS_TEST=200
# NUMBER_OF_DATA_REPEATS=1
# NUMBER_OF_DATA_REPEATS_TEST=1

DEBUG_KAFKA=false
LOG_TASK_INSTANCES=true

SAMPLING_CONSTANT=3


